QUERY_PORT=88
QUERY_ISSUER=10000
QUERY_GAME_ID=125
# Expert/debug override. Prefer LEGACY_SERVER_* below.
QUERY_SERVER_RECORDS=

# When HOST is set, query-server publishes one compatible Survival Heroes
# 3.3.3 server-list entry pointing at LEGACY_SERVER_PORT.
LEGACY_SERVER_ID=legacy-1
LEGACY_SERVER_DISTRICT=Legacy
LEGACY_SERVER_HOST=
LEGACY_SERVER_PORT=7001
# type: 0=normal, 1=recommended, 2=new
LEGACY_SERVER_TYPE=1
# open: 0=stopped, 1=open
LEGACY_SERVER_OPEN=1
# load: 0=good, 1=normal, 2=hot
LEGACY_SERVER_LOAD=0
# Lower value wins among recommended servers.
LEGACY_SERVER_PRIORITY=0

# Original member/login protocol compatibility service.
MEMBER_PORT=7001

# Controlled handshake experiment. Keep disabled until testing a client you own.
# Packet shape is recovered, but Field0/Mode semantics are still being validated.
MEMBER_SEND_SET_VERIFY=false
MEMBER_SET_VERIFY_FIELD0=0
MEMBER_SET_VERIFY_MODE=0
# Required only when MODE=1: exactly 16 bytes as 32 hex characters.
MEMBER_SET_VERIFY_KEY_HEX=

GATEWAY_PORT=8080
GAME_PORT=7000
GAME_PUBLIC_HOST=127.0.0.1
MATCH_SIZE=2
