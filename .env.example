QUERY_PORT=88
QUERY_ISSUER=10000
QUERY_GAME_ID=125
# Sobrescrita avançada/debug. Prefira usar LEGACY_SERVER_* abaixo.
QUERY_SERVER_RECORDS=

# Quando HOST estiver preenchido, o query-server publica uma entrada compatível
# com o Survival Heroes 3.3.3 apontando para LEGACY_SERVER_PORT.
LEGACY_SERVER_ID=legacy-1
LEGACY_SERVER_DISTRICT=Legacy
LEGACY_SERVER_HOST=
LEGACY_SERVER_PORT=7001
# type: 0=normal, 1=recomendado, 2=novo
LEGACY_SERVER_TYPE=1
# open: 0=fechado, 1=aberto
LEGACY_SERVER_OPEN=1
# load: 0=boa, 1=normal, 2=lotado
LEGACY_SERVER_LOAD=0
# Menor valor vence entre servidores recomendados.
LEGACY_SERVER_PRIORITY=0

# Serviço de compatibilidade do protocolo original de membro/login.
MEMBER_PORT=7001

# Experimento controlado de handshake. Mantenha desligado até testar com um
# cliente de sua propriedade.
# O formato do pacote foi recuperado; o significado de Field0/Mode ainda está
# sendo validado em execução real.
MEMBER_SEND_SET_VERIFY=false
MEMBER_SET_VERIFY_FIELD0=0
MEMBER_SET_VERIFY_MODE=0
# Necessário apenas quando MODE=1: exatamente 16 bytes em 32 caracteres hex.
MEMBER_SET_VERIFY_KEY_HEX=

# Se o cliente responder CLIENT_RET_ENCODE, permite enviar o SERVER_SET_ENCODE
# recuperado de 62 bytes.
MEMBER_SEND_SET_ENCODE=false

# Após um CLIENT_LOGIN válido, envia o prefixo recuperado de 41 bytes de
# SERVER_LOGIN_SUCCESS com role_count=0.
MEMBER_SEND_LOGIN_SUCCESS=false

# Responde CLIENT_WORLD_INFO com a estrutura recuperada de SERVER_WORLD_INFO.
MEMBER_SEND_WORLD_INFO=false
MEMBER_WORLD_INFO_FIELD0=0
MEMBER_WORLD_INFO_TEXT=

# Após CLIENT_CHOOSE_ROLE, envia tabelas iniciais vazias válidas.
MEMBER_SEND_SCENE_TABLES=false

# Entrada experimental na cena original. O par padrão 119-0 foi confirmado no
# registro de cenas do cliente como Scene=119 / Member=0 (moba_chiji).
MEMBER_SEND_ENTRY_SCENE=false
MEMBER_ENTRY_SCENE_FIELD0=0
MEMBER_ENTRY_SCENE_A=119
MEMBER_ENTRY_SCENE_B=0

GATEWAY_PORT=8080
GAME_PORT=7000
GAME_PUBLIC_HOST=127.0.0.1
MATCH_SIZE=2
